def reveal_step(original_blended, wrong_guesses):
    """
    Fades background out while simultaneously moving hidden bits into the
    top 4 positions, so at wrong_guesses=4 the hidden images are
    indistinguishable from the originals pasted by reveal_correct.
    """
    fade  = wrong_guesses / 4.0

    result = original_blended.copy()
    width, height = original_blended.size

    for x in range(width):
        for y in range(height):
            r, g, b = original_blended.getpixel((x, y))

            # Isolate background (top 4) and hidden (bottom 4)
            bg_r = r & 0b11110000
            bg_g = g & 0b11110000
            bg_b = b & 0b11110000

            # Repeat the 4 hidden bits into both halves for full 8-bit colour range
            hid_r = (r & 0b00001111) << 4 | (r & 0b00001111)
            hid_g = (g & 0b00001111) << 4 | (g & 0b00001111)
            hid_b = (b & 0b00001111) << 4 | (b & 0b00001111)

            # Fade background toward white
            faded_r = int(bg_r + (255 - bg_r) * fade)
            faded_g = int(bg_g + (255 - bg_g) * fade)
            faded_b = int(bg_b + (255 - bg_b) * fade)

            # Lerp: fade=0 → background, fade=1 → full hidden colour
            final_r = int(faded_r * (1 - fade) + hid_r * fade)
            final_g = int(faded_g * (1 - fade) + hid_g * fade)
            final_b = int(faded_b * (1 - fade) + hid_b * fade)

            result.putpixel((x, y), (final_r, final_g, final_b))

    return result

# ─────────────────────────────────────────────
#  REVEAL CORRECT — SHOW FULL IMAGE AT ITS POSITION
# ─────────────────────────────────────────────

def reveal_correct(original_blended, correct_item, images_dir, item_positions):
    """
    On a correct guess, paste the full original image at the exact position
    it was steganographically hidden at.
    """
    img_path = f"{images_dir}/{correct_item['image']}"
    img = Image.open(img_path).convert("RGB")

    result = original_blended.copy()
    bg_w, bg_h = result.size

    # Resize the same way it was resized during embedding
    target_width = bg_w // 4
    w, h  = img.size
    scale = min(1.0, target_width / w)
    img   = img.resize((int(w * scale), int(h * scale)), Image.LANCZOS)

    # Paste at the exact stored position
    x, y = item_positions[correct_item["name"]]
    result.paste(img, (x, y))

    result.save("reveal.jpg")
    result.show()


# ─────────────────────────────────────────────
#  HINT DISPLAY
# ─────────────────────────────────────────────

def show_hints(target_item: dict, wrong_guesses: int):
    """Print one hint for the target item per wrong guess, revealed progressively."""
    print("\n── Hints ──────────────────────────────")
    revealed = target_item["hints"][:wrong_guesses]
    locked   = ["???"] * (4 - wrong_guesses)
    hint_str = " | ".join(revealed + locked)
    print(f"  {hint_str}")
    print("────────────────────────────────────────\n")


# ─────────────────────────────────────────────
#  MAIN COMPOSE + GAME LOOP
# ─────────────────────────────────────────────

def compose_and_play(csv_path: str, images_dir: str = "."):
    """
    csv_path   : path to your CSV file
    images_dir : folder where the .jpg/.png image files live
    """

    # 1. Load all items from CSV, pick 5 at random to embed
    all_items = load_items_from_csv(csv_path)
    selected  = random.sample(all_items, min(5, len(all_items)))
    target    = random.choice(selected)
    print(f"\nEmbedding items: {[i['name'] for i in selected]}")
    print(f"The user must find: '{target['name']}'\n")

    # 2. Load background
    bg_path    = bg_im()
    background = Image.open(bg_path).convert("RGB")
    bg_w, bg_h = background.size

    # 3. Load, resize, and steganographically embed all 5 hidden images
    placed_boxes  = []
    loaded_items  = []
    item_positions = {}  # stores {name: (x, y)} for each successfully placed image

    for item in selected:
        img_path = f"{images_dir}/{item['image']}"
        try:
            img = Image.open(img_path).convert("RGB")
        except FileNotFoundError:
            print(f"Warning: could not find {img_path}, skipping.")
            continue

        # Scale to ~1/4 of background width
        target_width = bg_w // 4
        w, h  = img.size
        scale = min(1.0, target_width / w)
        img   = img.resize((int(w * scale), int(h * scale)), Image.LANCZOS)

        fg_w, fg_h = img.size
        pos = find_non_overlapping_position(bg_w, bg_h, fg_w, fg_h, placed_boxes)
        if pos is None:
            print(f"Warning: no room for {item['name']}, skipping.")
            continue

        placed_boxes.append((pos[0], pos[1], fg_w, fg_h))
        blend_hidden_onto_background(background, img, pos)
        loaded_items.append(item)
        item_positions[item["name"]] = pos  # store the position
        print(f"Embedded '{item['name']}' at position {pos}")

    if not loaded_items:
        print("No images could be loaded. Exiting.")
        return

    # Make sure the target was actually loaded; fall back if not
    if target not in loaded_items:
        target = random.choice(loaded_items)
        print(f"Original target skipped, new target: '{target['name']}'")

    # 4. Freeze the blended image and save initial state
    original_blended = background.copy()
    original_blended.save("reveal.jpg")
    print("\nInitial blended image saved as reveal.jpg")

    # 5. Game loop — user guesses the ONE target item
    wrong_guesses = 0
    MAX_WRONG     = 4

    print(f"\nCan you find the hidden '{target['name']}'?")
    print("The background will fade with each wrong guess, revealing all hidden images.\n")

    while wrong_guesses <= MAX_WRONG:
        # Overwrite reveal.jpg with the progressively faded background
        current_image = reveal_step(original_blended, wrong_guesses)
        current_image.save("reveal.jpg")
        current_image.show()

        # Show progressive hints for the target item only
        show_hints(target, wrong_guesses)

        if wrong_guesses == MAX_WRONG:
            print(f"Out of guesses! The hidden item was: '{target['name']}'")
            break

        guess = input("Guess the hidden object: ").strip().lower()

        if guess == target["name"].lower():
            print(f"✓ Correct! You found the '{target['name']}'!")
            reveal_correct(original_blended, target, images_dir, item_positions)
            break
        else:
            wrong_guesses += 1
            print(f"✗ Wrong! ({wrong_guesses}/{MAX_WRONG} wrong guesses)")


# ─────────────────────────────────────────────
#  ENTRY POINT
# ─────────────────────────────────────────────

if __name__ == "__main__":
    compose_and_play(
        csv_path="TThints.csv",
        images_dir="img",
    )
